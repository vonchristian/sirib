<div class="space-y-6"> 
  <div class="card"> 
    <div class="card-header"> 
      <h3 class="card-header-title">Audit Information</h3>
 </div>

    <div class="card-body"> 
      <dl class="space-y-2.5 text-sm"> 
        <div class="flex justify-between"> 
          <dt class="text-text-tertiary">Created</dt>

          <dd class="text-text-primary font-medium"><%= @member.created_at.strftime("%b %d, %Y %H:%M") %></dd>
 </div>

        <div class="flex justify-between"> 
          <dt class="text-text-tertiary">Last Updated</dt>

          <dd class="text-text-primary font-medium"><%= @member.updated_at.strftime("%b %d, %Y %H:%M") %></dd>
 </div>
 </dl>
 </div>
 </div>

  <div class="card"> 
    <div class="card-header"> 
      <h3 class="card-header-title">Profile Settings</h3>
 </div>

    <div class="card-body"> 
      <div class="space-y-1.5"> <%= link_to edit_member_path(@member), class:"flex items-center gap-2 rounded-md px-3 py-2 text-sm text-text-secondary hover:bg-surface-alt transition-colors" do %> <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /> </svg> Edit Profile <% end %> <%= link_to edit_member_path(@member, anchor:"identifications"), class:"flex items-center gap-2 rounded-md px-3 py-2 text-sm text-text-secondary hover:bg-surface-alt transition-colors" do %> <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /> </svg> Upload ID <% end %> <%= link_to edit_member_path(@member), class:"flex items-center gap-2 rounded-md px-3 py-2 text-sm text-text-secondary hover:bg-surface-alt transition-colors" do %> <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /> <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /> </svg> Update Address <% end %> </div>
 </div>
 </div>


